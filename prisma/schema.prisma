// =============================================================================
// M-CORE Ã¢â‚¬â€ Prisma Schema
// =============================================================================
//
// Dokumen ini adalah implementasi DATABASE.md ke dalam Prisma ORM.
//
// PENTING:
// - Setiap perubahan schema HARUS mengikuti DATABASE.md terlebih dahulu.
// - Setiap perubahan schema HARUS melalui migrasi (prisma migrate dev).
// - JANGAN mengubah schema ini secara manual di production.
// - Baca DATABASE.md sebelum menambahkan field baru.
//
// Referensi: DATABASE.md v1.0.0
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Jenjang akademik untuk grouping Academic Master.
enum AcademicLevel {
  JUNIOR_HIGH
  SENIOR_HIGH
  PRE_UNIVERSITY
}

/// Status periode pendaftaran program.
enum EnrollmentPeriodStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

/// Status calon peserta pada proses verifikasi pendaftaran.
enum ApplicantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  TRANSFER
  CASH
}

/// Jenis kelamin siswa.
/// Nilai: male | female
/// Referensi: DATABASE.md Â§8
enum Gender {
  male
  female
}

/// Status utama siswa dalam sistem.
/// ACTIVE = masih mengikuti program
/// ALUMNI = telah menyelesaikan perjalanan pendidikan
/// INACTIVE = tidak sedang aktif, belum alumni
/// Referensi: DATABASE.md Ã‚Â§9, BUSINESS_RULES.md Ã‚Â§10-13
enum StudentStatus {
  active
  alumni
  inactive
}

/// Status riwayat program siswa.
/// ENROLLED = sedang aktif di program ini (program aktif)
/// COMPLETED = selesai dari program/kelas ini
/// TRANSFERRED = pindah ke program lain (lihat BUSINESS_RULES.md Ã‚Â§22)
/// DROPPED = berhenti
/// CANCELLED = dibatalkan administratif
/// Referensi: DATABASE.md Ã‚Â§16, BUSINESS_RULES.md Ã‚Â§16-25
enum ProgramHistoryStatus {
  enrolled
  completed
  transferred
  dropped
  cancelled
}

// =============================================================================
// MODEL: Student
//
// Tabel master identitas siswa. Satu siswa hanya boleh memiliki satu record.
// student_id adalah identitas internal M-CORE yang TIDAK BOLEH berubah.
//
// PRINSIP UTAMA: ONE STUDENT Ã¢â‚¬â€ ONE IDENTITY
// Referensi: DATABASE.md Ã‚Â§6, Ã‚Â§7, BUSINESS_RULES.md Ã‚Â§4-5
// =============================================================================
model Student {
  /// ID internal M-CORE. UUID, tidak boleh berubah sepanjang lifecycle siswa.
  /// Jangan pernah menggunakan NIK, email, atau nomor HP sebagai student_id.
  id String @id @default(uuid()) @map("student_id")

  studentNumber Int     @unique @default(autoincrement()) @map("student_number")
  mtsStudentId  String? @unique @map("mts_student_id") @db.VarChar(50)
  maStudentId   String? @unique @map("ma_student_id") @db.VarChar(50)

  /// URL publik foto profil siswa yang disimpan di Cloudinary.
  photoUrl String? @map("photo_url") @db.VarChar(500)

  /// Public ID asset Cloudinary untuk penggantian dan penghapusan foto.
  photoPublicId String? @map("photo_public_id") @db.VarChar(255)

  /// Nama lengkap siswa. Required.
  fullName String @map("full_name") @db.VarChar(150)

  /// Jenis kelamin. Hanya 'male' atau 'female'.
  gender Gender

  /// Tempat lahir. Opsional karena tidak semua siswa baru memiliki data ini.
  birthPlace String? @map("birth_place") @db.VarChar(100)

  /// Tanggal lahir. Opsional untuk fleksibilitas input awal.
  birthDate DateTime? @map("birth_date") @db.Date

  /// Nomor Induk Kependudukan (16 digit).
  /// UNIQUE jika tersedia, NULL jika belum ada.
  /// JANGAN simpan sebagai integer Ã¢â‚¬â€ NIK bisa memiliki leading zero.
  /// Referensi: DATABASE.md Ã‚Â§10, BUSINESS_RULES.md Ã‚Â§6-7
  nik              String? @unique @db.VarChar(16)
  nisn             String? @unique @db.VarChar(20)
  familyCardNumber String? @map("family_card_number") @db.VarChar(20)
  passportNumber   String? @map("passport_number") @db.VarChar(30)

  /// Email siswa. UNIQUE (case-insensitive) jika tersedia.
  /// Perbandingan email harus case-insensitive (lihat index di bawah).
  /// Referensi: DATABASE.md Ã‚Â§11
  email String? @db.VarChar(150)

  /// Nomor HP utama. Opsional.
  phone String? @db.VarChar(20)

  /// Nomor WhatsApp. Opsional (bisa sama atau berbeda dengan phone).
  whatsapp         String? @db.VarChar(20)
  telegramUsername String? @map("telegram_username") @db.VarChar(100)

  addressLine String? @map("address_line") @db.VarChar(255)
  addressRt   String? @map("address_rt") @db.VarChar(5)
  addressRw   String? @map("address_rw") @db.VarChar(5)
  village     String? @db.VarChar(100)
  district    String? @db.VarChar(100)
  cityRegency String? @map("city_regency") @db.VarChar(100)
  province    String? @db.VarChar(100)
  postalCode  String? @map("postal_code") @db.VarChar(10)

  heightCm     Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  siblingCount Int?     @map("sibling_count")
  birthOrder   Int?     @map("birth_order")

  /// Status siswa saat ini.
  /// Default: ACTIVE saat pertama didaftarkan.
  /// Perubahan status harus mengikuti BUSINESS_RULES.md.
  status StudentStatus @default(active)

  /// Timestamp dibuat. Otomatis diisi saat insert.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Timestamp diperbarui. Harus diupdate setiap kali record berubah.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  programHistories   StudentProgramHistory[]
  classEnrollments   ClassEnrollment[]
  attendanceRecords  AttendanceRecord[]
  grades             Grade[]
  guardianConfig     StudentGuardian?
  applicants         Applicant[]
  userProfile        UserProfile?
  parents            StudentParent[]
  educationHistories StudentEducationHistory[]

  // Indeks untuk performa query.
  // Referensi: DATABASE.md Ã‚Â§22
  @@index([fullName])
  @@index([status])
  @@index([birthDate])
  @@map("students")
}

enum EducationHistoryLevel {
  elementary
  junior_high
  senior_high
  university
  university_s1
  university_s2
  university_s3
}

model StudentEducationHistory {
  id              String                @id @default(uuid()) @map("education_history_id")
  studentId       String                @map("student_id")
  level           EducationHistoryLevel
  institutionName String                @map("institution_name") @db.VarChar(150)
  cityRegency     String?               @map("city_regency") @db.VarChar(100)
  province        String?               @db.VarChar(100)
  graduationYear  Int?                  @map("graduation_year")
  degreeLevel     String?               @map("degree_level") @db.VarChar(10)
  student         Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([studentId, level])
  @@index([studentId])
  @@map("student_education_histories")
}

enum ParentRole {
  father
  mother
  other
}

enum GuardianSource {
  father
  mother
  other
}

model StudentParent {
  id              String            @id @default(uuid()) @map("parent_id")
  studentId       String            @map("student_id")
  role            ParentRole
  fullName        String            @map("full_name") @db.VarChar(150)
  nik             String?           @db.VarChar(16)
  phone           String?           @db.VarChar(20)
  education       String?           @db.VarChar(100)
  educationOther  String?           @map("education_other") @db.VarChar(100)
  occupation      String?           @db.VarChar(100)
  occupationOther String?           @map("occupation_other") @db.VarChar(100)
  monthlyIncome   Int?              @map("monthly_income")
  relationship    String?           @db.VarChar(100)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianLinks   StudentGuardian[] @relation("OtherParent")

  @@unique([studentId, role])
  @@index([studentId])
  @@map("student_parents")
}

model StudentGuardian {
  id                  String         @id @default(uuid()) @map("guardian_id")
  studentId           String         @unique @map("student_id")
  guardianIsDifferent Boolean        @default(false) @map("guardian_is_different")
  guardianSource      GuardianSource @default(father) @map("guardian_source")
  otherParentId       String?        @map("other_parent_id")
  student             Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  otherParent         StudentParent? @relation("OtherParent", fields: [otherParentId], references: [id], onDelete: SetNull)

  @@index([otherParentId])
  @@map("student_guardians")
}

// =============================================================================
// MODEL: Program
//
// Tabel master seluruh program yang tersedia di M-CORE.
// Contoh: MTs, MA, Pra-Universitas, Program Turkiye, dll.
//
// Program yang sudah tidak digunakan TIDAK boleh dihapus.
// Gunakan isActive = false untuk menonaktifkan.
// Referensi: DATABASE.md Ã‚Â§12-14
// =============================================================================
model Program {
  /// ID internal program.
  id String @id @default(uuid()) @map("program_id")

  /// Kode program. Dapat digunakan kembali pada tahun akademik berbeda.
  programCode String @map("program_code") @db.VarChar(50)

  /// Nama lengkap program.
  programName String @map("program_name") @db.VarChar(150)

  /// Tahun akademik/program saat record ini aktif.
  academicYear String @default("2025/2026") @map("academic_year") @db.VarChar(9)

  /// Periode tampilan/operasional program. Pra-Univ dapat menggunakan tahun tunggal, misalnya 2026.
  academicPeriod String @default("2025/2026") @map("academic_period") @db.VarChar(9)

  /// Jenjang pendidikan lama untuk kompatibilitas.
  educationLevel String?        @map("education_level") @db.VarChar(100)
  /// Jenjang resmi untuk grouping Academic Master.
  academicLevel  AcademicLevel? @map("academic_level")

  /// Status aktif program.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  programHistories      StudentProgramHistory[]
  academicClasses       AcademicClass[]
  juniorHighClasses     JuniorHighClass[]
  seniorHighClasses     SeniorHighClass[]
  preUniversityPrograms PreUniversityProgram[]
  enrollmentPeriods     EnrollmentPeriod[]
  applicants            Applicant[]
  scopeAssignments      ScopeAssignment[]
  classDefinitions      ClassDefinition[]

  @@unique([programCode, academicYear], name: "uq_program_code_academic_year")
  @@index([programName])
  @@index([isActive])
  @@index([academicLevel])
  @@index([academicYear])
  @@index([academicPeriod])
  @@map("programs")
}

/// Konfigurasi pendaftaran program untuk satu periode akademik.
/// Satu program dapat dibuka kembali pada periode berbeda tanpa mengubah histori lama.
model EnrollmentPeriod {
  id              String                    @id @default(uuid()) @map("enrollment_period_id")
  programId       String                    @map("program_id")
  formTemplateId  String?                   @map("form_template_id")
  name            String                    @db.VarChar(150)
  status          EnrollmentPeriodStatus    @default(DRAFT)
  registrationFee Int                       @map("registration_fee")
  currency        String                    @default("IDR") @db.Char(3)
  startsAt        DateTime                  @map("starts_at") @db.Timestamptz()
  endsAt          DateTime                  @map("ends_at") @db.Timestamptz()
  notes           String?                   @db.Text
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()
  program         Program                   @relation(fields: [programId], references: [id], onDelete: Restrict)
  formTemplate    RegistrationFormTemplate? @relation(fields: [formTemplateId], references: [id], onDelete: SetNull)
  applicants      Applicant[]

  @@index([programId, status])
  @@index([status, startsAt, endsAt])
  @@index([formTemplateId])
  @@map("enrollment_periods")
}

model RegistrationFormTemplate {
  id             String             @id @default(uuid()) @map("form_template_id")
  name           String             @unique @db.VarChar(150)
  selectedFields Json               @map("selected_fields")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  periods        EnrollmentPeriod[]

  @@map("registration_form_templates")
}

// =============================================================================
// MODEL: Applicant
// =============================================================================
model Applicant {
  id                 String           @id @default(uuid()) @map("applicant_id")
  registrationNo     String           @unique @map("registration_no") @db.VarChar(40)
  publicToken        String           @unique @map("public_token") @db.VarChar(80)
  fullName           String?          @map("full_name") @db.VarChar(150)
  gender             Gender?
  birthPlace         String?          @map("birth_place") @db.VarChar(100)
  birthDate          DateTime?        @map("birth_date") @db.Date
  nationalId         String?          @unique @map("national_id") @db.VarChar(30)
  email              String?          @db.VarChar(180)
  studentPhone       String?          @map("student_phone") @db.VarChar(30)
  studentWhatsapp    String?          @map("student_whatsapp") @db.VarChar(30)
  parentPhone        String?          @map("parent_phone") @db.VarChar(30)
  educationHistory   Json?            @map("education_history")
  programId          String           @map("program_id")
  enrollmentPeriodId String           @map("enrollment_period_id")
  studentId          String?          @map("student_id")
  paymentProofUrl    String?          @map("payment_proof_url") @db.VarChar(500)
  paymentMethod      PaymentMethod?   @map("payment_method")
  status             ApplicantStatus  @default(PENDING)
  submittedAt        DateTime?        @map("submitted_at") @db.Timestamptz()
  rejectionReason    String?          @map("rejection_reason") @db.VarChar(500)
  reviewedAt         DateTime?        @map("reviewed_at") @db.Timestamptz()
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  program            Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  enrollmentPeriod   EnrollmentPeriod @relation(fields: [enrollmentPeriodId], references: [id], onDelete: Restrict)
  student            Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([programId])
  @@index([enrollmentPeriodId])
  @@index([studentId])
  @@map("applicants")
}

// =============================================================================
// MODEL: StudentProgramHistory
//
// Menyimpan SELURUH perjalanan siswa dalam program M-CORE.
// Ini adalah tabel paling penting untuk menjaga riwayat pendidikan.
//
// PRINSIP IMMUTABLE HISTORY:
// Data historis TIDAK BOLEH diubah sembarangan.
// Ketika perubahan terjadi:
//   1. Record lama diubah statusnya (completed/transferred/dropped)
//   2. Record baru dibuat untuk program/kelas berikutnya
//   JANGAN overwrite record lama dengan data baru.
//
// Referensi: DATABASE.md Ã‚Â§15-18, BUSINESS_RULES.md Ã‚Â§16-25
// =============================================================================
model StudentProgramHistory {
  /// ID riwayat. UUID, primary key.
  id String @id @default(uuid()) @map("history_id")

  /// Foreign key ke tabel students.
  /// ON DELETE RESTRICT: tidak bisa hapus student jika masih punya history.
  studentId String @map("student_id")

  /// Foreign key ke tabel programs.
  /// ON DELETE RESTRICT: tidak bisa hapus program jika masih digunakan history.
  programId String @map("program_id")

  /// Tahun akademik. Format: YYYY/YYYY. Contoh: "2024/2025", "2025/2026".
  /// Validasi format dilakukan di application layer dengan Zod.
  /// Referensi: DATABASE.md Ã‚Â§17
  academicYear String @map("academic_year") @db.VarChar(9)

  /// Level/jenjang dalam program. Opsional karena tidak semua program pakai sistem ini.
  /// Contoh MTs: "MTs" | Pra-Univ: "Persiapan" | Bahasa: "Turkish Language"
  level String? @db.VarChar(50)

  country String? @db.VarChar(100)

  /// Nama kelas. Opsional.
  /// Contoh: "VII", "VIII", "IX", "Batch 1", "A2"
  className String? @map("class_name") @db.VarChar(50)

  /// Status enrollment saat ini.
  /// ENROLLED = program aktif siswa ini.
  /// Default: ENROLLED saat record baru dibuat.
  status ProgramHistoryStatus @default(enrolled)

  /// Tanggal mulai enrollment. Opsional.
  startDate DateTime? @map("start_date") @db.Date

  /// Tanggal selesai enrollment. Diisi saat status berubah dari ENROLLED.
  endDate DateTime? @map("end_date") @db.Date

  /// Catatan tambahan. Opsional.
  /// Contoh: alasan transfer, catatan akademik khusus.
  notes String? @db.Text

  /// Timestamp dibuat.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Timestamp diperbarui.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relasi
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  program         Program          @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  classEnrollment ClassEnrollment?

  // Multiple immutable history records are allowed for re-enrollment after transfer/drop.
  @@index([studentId, programId, academicYear], name: "idx_student_program_year")
  // Indeks untuk performa query.
  @@index([studentId])
  @@index([programId])
  @@index([academicYear])
  @@index([status])
  @@index([studentId, academicYear])
  @@map("student_program_history")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACADEMIC
  OPERATOR
  TEACHER
  VIEWER
}

enum ScopeType {
  all
  program
  class
}

model UserProfile {
  id           String   @id @default(uuid()) @map("user_id")
  authId       String   @unique @map("auth_id") @db.Uuid
  email        String?  @unique @db.VarChar(150)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  studentId    String?  @unique @map("student_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  student     Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher     Teacher?
  roles       UserRoleAssignment[]
  scopes      ScopeAssignment[]
  auditLogs   AuditLog[]
  sessions    AuthSession[]
  resetTokens PasswordResetToken[]

  @@map("user_profiles")
}

model AuthSession {
  id        String   @id @default(uuid()) @map("session_id")
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @map("reset_token_id")
  userId    String    @map("user_id")
  token     String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String               @id @default(uuid()) @map("role_id")
  name        UserRole             @unique
  description String?              @db.VarChar(255)
  users       UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @map("permission_id")
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRoleAssignment {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ScopeAssignment {
  id        String    @id @default(uuid()) @map("scope_id")
  userId    String    @map("user_id")
  type      ScopeType
  programId String?   @map("program_id")
  className String?   @map("class_name") @db.VarChar(50)

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([programId])
  @@index([type])
  @@map("scope_assignments")
}

model AuditLog {
  id         String   @id @default(uuid()) @map("audit_id")
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(80)
  resource   String   @db.VarChar(80)
  resourceId String?  @map("resource_id") @db.VarChar(100)
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  actor UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// PHASE 5: ACADEMIC STRUCTURE
// Each class belongs to exactly one program and one academic year.
// =============================================================================
model AcademicYear {
  id                    String                  @id @default(uuid()) @map("academic_year_id")
  code                  String                  @unique @db.VarChar(9)
  label                 String                  @db.VarChar(100)
  startDate             DateTime                @map("start_date") @db.Date
  endDate               DateTime                @map("end_date") @db.Date
  isActive              Boolean                 @default(false) @map("is_active")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz()
  classes               AcademicClass[]
  juniorHighClasses     JuniorHighClass[]
  seniorHighClasses     SeniorHighClass[]
  preUniversityPrograms PreUniversityProgram[]
  histories             AcademicMasterHistory[]
  levelSettings         AcademicLevelSetting[]

  @@index([isActive])
  @@map("academic_years")
}

/// Kelompok kelas Junior High/SMP. Dipisahkan dari jenjang lain agar atribut kelas tidak saling nullable dan tidak terjadi anomali update.

model AcademicLevelSetting {
  id             String        @id @default(uuid()) @map("academic_level_setting_id")
  academicLevel  AcademicLevel @unique @map("academic_level")
  academicYearId String        @map("academic_year_id")
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("academic_level_settings")
}

// =============================================================================
// PROGRAM CATALOG — ClassDefinition & ClassSlot
//
// ClassDefinition = template baku nama grade per program (terkunci oleh admin).
// ClassSlot       = rombel aktual per ClassDefinition (A, B, C, dst — opsional).
//
// Aliran data:
//   Program → ClassDefinition (grade 7/8/9 atau 10/11/12)
//                  └── ClassSlot (rombel A, B, C, dst.)
//                           └── JuniorHighClass / SeniorHighClass (instance aktif per tahun)
//
// Sumber kebenaran tunggal untuk: dashboard, absensi, jadwal, rekap, laporan.
// =============================================================================

/// Template baku nama grade per program. Nama grade TIDAK boleh diubah pengguna biasa.
model ClassDefinition {
  id            String        @id @default(uuid()) @map("class_def_id")
  programId     String        @map("program_id")

  /// Nomor grade: 7, 8, 9 untuk MTs; 10, 11, 12 untuk MA.
  grade         Int

  /// Label nama grade yang baku. Contoh: "Kelas 7", "Kelas 10".
  /// Hanya dapat diubah oleh SUPER_ADMIN melalui form khusus dengan konfirmasi.
  gradeLabel    String        @db.VarChar(30)   @map("grade_label")

  /// Jumlah rombel default saat program dibuat. Default 1.
  defaultSlots  Int           @default(1)        @map("default_slots")

  /// Status aktif definisi kelas ini.
  isActive      Boolean       @default(true)     @map("is_active")

  createdAt     DateTime      @default(now())    @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt         @map("updated_at") @db.Timestamptz()

  program       Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  slots         ClassSlot[]

  /// Satu program hanya boleh punya satu ClassDefinition per grade.
  @@unique([programId, grade], name: "uq_class_def_program_grade")
  @@index([programId])
  @@index([isActive])
  @@map("class_definitions")
}

/// Rombel aktual per ClassDefinition. Satu grade bisa punya lebih dari 1 rombel (A, B, C, dst).
/// displayName dikalkulasi: gradeLabel + " " + suffix (atau hanya gradeLabel jika suffix kosong).
model ClassSlot {
  id              String          @id @default(uuid()) @map("class_slot_id")
  classDefId      String          @map("class_def_id")

  /// Suffix rombel: "A", "B", "C", atau "" (kosong = hanya satu rombel tanpa suffix).
  suffix          String          @db.VarChar(10)

  /// Nama tampilan final. Contoh: "Kelas 7", "Kelas 7A", "Kelas 7B".
  displayName     String          @db.VarChar(60)    @map("display_name")

  /// Kapasitas maksimal siswa per rombel. Opsional.
  capacity        Int?

  /// Status aktif rombel ini.
  isActive        Boolean         @default(true)     @map("is_active")

  createdAt       DateTime        @default(now())    @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt         @map("updated_at") @db.Timestamptz()

  classDef        ClassDefinition @relation(fields: [classDefId], references: [id], onDelete: Restrict)
  juniorHighClasses JuniorHighClass[]
  seniorHighClasses SeniorHighClass[]

  /// Satu ClassDefinition tidak boleh punya dua slot dengan suffix yang sama.
  @@unique([classDefId, suffix], name: "uq_class_slot_def_suffix")
  @@index([classDefId])
  @@index([isActive])
  @@map("class_slots")
}

model JuniorHighClass {
  id             String       @id @default(uuid()) @map("junior_high_class_id")
  programId      String       @map("program_id")
  academicYearId String       @map("academic_year_id")
  /// FK opsional ke ClassSlot. Null pada data lama (kompatibilitas mundur).
  classSlotId    String?      @map("class_slot_id")
  code           String       @db.VarChar(50)
  name           String       @db.VarChar(100)
  grade          Int
  capacity       Int?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  program        Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classSlot      ClassSlot?   @relation(fields: [classSlotId], references: [id], onDelete: SetNull)

  @@unique([academicYearId, programId, code], name: "uq_junior_high_class_context")
  @@index([programId])
  @@index([academicYearId])
  @@index([classSlotId])
  @@map("junior_high_classes")
}

/// Kelompok kelas Senior High/SMA. Terpisah dari Junior High karena aturan grade dan atribut dapat berkembang independen.
model SeniorHighClass {
  id             String       @id @default(uuid()) @map("senior_high_class_id")
  programId      String       @map("program_id")
  academicYearId String       @map("academic_year_id")
  /// FK opsional ke ClassSlot. Null pada data lama (kompatibilitas mundur).
  classSlotId    String?      @map("class_slot_id")
  code           String       @db.VarChar(50)
  name           String       @db.VarChar(100)
  grade          Int
  specialization String?      @db.VarChar(100)
  capacity       Int?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  program        Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classSlot      ClassSlot?   @relation(fields: [classSlotId], references: [id], onDelete: SetNull)

  @@unique([academicYearId, programId, code], name: "uq_senior_high_class_context")
  @@index([programId])
  @@index([academicYearId])
  @@index([classSlotId])
  @@map("senior_high_classes")
}

/// Program Pre-University. Dipisahkan dari tabel kelas sekolah karena memakai tujuan studi, bukan grade kelas.
model PreUniversityProgram {
  id             String       @id @default(uuid()) @map("pre_university_program_id")
  programId      String       @map("program_id")
  academicYearId String       @map("academic_year_id")
  code           String       @db.VarChar(50)
  name           String       @db.VarChar(150)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  program        Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([academicYearId, programId, code], name: "uq_pre_university_program_context")
  @@index([programId])
  @@index([academicYearId])
  @@map("pre_university_programs")
}

model AcademicClass {
  id                 String              @id @default(uuid()) @map("class_id")
  programId          String              @map("program_id")
  academicYearId     String              @map("academic_year_id")
  code               String              @db.VarChar(50)
  name               String              @db.VarChar(100)
  capacity           Int?
  isActive           Boolean             @default(true) @map("is_active")

  /// FK wali kelas. Berbeda dari teacher (guru pengajar) karena wali kelas hanya satu per kelas.
  homeRoomTeacherId  String?             @map("home_room_teacher_id")

  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  program            Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  homeRoomTeacher    Teacher?            @relation("ClassHomeRoom", fields: [homeRoomTeacherId], references: [id], onDelete: SetNull)
  teachers           Teacher[]
  enrollments        ClassEnrollment[]
  schedules          Schedule[]
  attendanceSessions AttendanceSession[]
  grades             Grade[]

  @@unique([academicYearId, programId, code], name: "uq_academic_class_context")
  @@index([programId])
  @@index([academicYearId])
  @@index([homeRoomTeacherId])
  @@map("academic_classes")
}

model Subject {
  id          String     @id @default(uuid()) @map("subject_id")
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(150)
  description String?    @db.VarChar(500)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  schedules   Schedule[]
  grades      Grade[]

  @@index([name])
  @@index([isActive])
  @@map("subjects")
}

model PreUniversityCountry {
  id        String   @id @default(uuid()) @map("country_id")
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("pre_university_countries")
}

model AcademicMasterHistory {
  id             String        @id @default(uuid()) @map("history_id")
  academicLevel  AcademicLevel @map("academic_level")
  academicYearId String?       @map("academic_year_id")
  snapshot       Json
  actorId        String?       @map("actor_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([academicLevel, createdAt])
  @@index([academicYearId])
  @@map("academic_master_histories")
}

model Teacher {
  id            String          @id @default(uuid()) @map("teacher_id")
  userProfileId String?         @unique @map("user_id")
  employeeCode  String?         @unique @map("employee_code") @db.VarChar(50)
  displayName   String          @map("display_name") @db.VarChar(150)
  isActive      Boolean         @default(true) @map("is_active")
  profile       Json?
  address       Json?
  employment    Json?
  education     Json?
  spouse        Json?
  family        Json?
  documents     Json?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  userProfile   UserProfile?    @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  classes       AcademicClass[]
  homeRoomClasses AcademicClass[] @relation("ClassHomeRoom")
  schedules     Schedule[]

  @@index([displayName])
  @@index([isActive])
  @@map("teachers")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  SICK
  PERMISSION
}

enum AcademicRecordStatus {
  ACTIVE
  CANCELLED
}

model ClassEnrollment {
  id         String                @id @default(uuid()) @map("class_enrollment_id")
  historyId  String                @unique @map("history_id")
  classId    String                @map("class_id")
  assignedAt DateTime              @default(now()) @map("assigned_at") @db.Timestamptz()
  endedAt    DateTime?             @map("ended_at") @db.Timestamptz()
  student    Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId  String                @map("student_id")
  history    StudentProgramHistory @relation(fields: [historyId], references: [id], onDelete: Restrict)
  class      AcademicClass         @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@index([classId])
  @@map("class_enrollments")
}

model Schedule {
  id                 String               @id @default(uuid()) @map("schedule_id")
  classId            String               @map("class_id")
  subjectId          String               @map("subject_id")
  teacherId          String               @map("teacher_id")
  day                Int
  startTime          String               @map("start_time") @db.VarChar(5)
  endTime            String               @map("end_time") @db.VarChar(5)
  room               String?              @db.VarChar(100)
  status             AcademicRecordStatus @default(ACTIVE)
  class              AcademicClass        @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject            Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher            Teacher              @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  attendanceSessions AttendanceSession[]

  @@index([classId, day])
  @@index([teacherId, day])
  @@map("schedules")
}

model AttendanceSession {
  id          String             @id @default(uuid()) @map("attendance_session_id")
  classId     String             @map("class_id")
  scheduleId  String?            @map("schedule_id")
  sessionDate DateTime           @map("session_date") @db.Date
  topic       String?            @db.VarChar(255)
  createdBy   String             @map("created_by")
  class       AcademicClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  schedule    Schedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  records     AttendanceRecord[]

  @@unique([classId, sessionDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid()) @map("attendance_record_id")
  sessionId String            @map("session_id")
  studentId String            @map("student_id")
  status    AttendanceStatus
  notes     String?           @db.VarChar(255)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model Grade {
  id            String        @id @default(uuid()) @map("grade_id")
  studentId     String        @map("student_id")
  classId       String        @map("class_id")
  subjectId     String        @map("subject_id")
  assessmentKey String        @map("assessment_key") @db.VarChar(80)
  score         Decimal       @db.Decimal(5, 2)
  letterGrade   String?       @map("letter_grade") @db.VarChar(3)
  notes         String?       @db.VarChar(255)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class         AcademicClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([studentId, classId, subjectId, assessmentKey])
  @@index([classId, subjectId])
  @@map("grades")
}

/// Tautan pendek yang dapat dibagikan.
model Shortlink {
  id        String   @id @default(cuid())
  title     String
  targetUrl String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
